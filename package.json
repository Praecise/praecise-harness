{
  "name": "praecise",
  "version": "0.1.0",
  "description": "The framework for AI agents. A folder is an app \u2014 write what an agent knows and can do, run it.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Hilal Agil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Praecise/praecise-harness.git"
  },
  "bugs": {
    "url": "https://github.com/Praecise/praecise-harness/issues"
  },
  "homepage": "https://github.com/Praecise/praecise-harness#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "praecise": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/reference-node-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm run build",
    "verify:wires": "node scripts/verify-wires.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test",
    "release:check": "npm run check && npm run build && npm pack --dry-run"
  },
  "keywords": [
    "ai",
    "agents",
    "framework",
    "orchestration",
    "mcp",
    "praecise"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@types/node": "^26.2.0"
  }
}
